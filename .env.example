POSTGRES_DB=medicii
POSTGRES_USER=medicii
POSTGRES_PASSWORD=development_only_change_me
DATABASE_URL=postgresql+psycopg://medicii:development_only_change_me@db:5432/medicii
# For Supabase Docker mode, copy the Postgres connection string from the Supabase
# Connect panel, replace postgres:// with postgresql+psycopg://, and append
# ?sslmode=require. Keep this value private; it is used by FastAPI only.
SUPABASE_DATABASE_URL=
SUPABASE_POOLER_DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
STRIPE_TAX_ENABLED=false
STRIPE_INVOICE_CREATION_ENABLED=true
EMAIL_FROM=noreply@medicii.net
ORDERS_EMAIL=orders@medicii.net
# Optional additional operations/admin inbox. Multiple recipients are allowed, separated by commas.
ADMIN_NOTIFICATION_EMAIL=
SUPPORT_EMAIL=support@medicii.net
BILLING_EMAIL=billing@medicii.net
MARKETING_EMAIL=marketing@medicii.net
# SMTP credentials are secrets. Leave blank for local log-only delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Microsoft Graph alternative to SMTP. Use a private client secret only in .env.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=noreply@medicii.net
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
